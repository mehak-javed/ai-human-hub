# Copy to .env and fill in. Never commit .env.
DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000
DATABASE_URL=
CLERK_SECRET_KEY=

# Speech-to-text. Set at least one provider; Groq is the backup.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_TOKEN=
GROQ_API_KEY=

# GitHub App that sends approved stories to private repos (optional locally).
# GITHUB_APP_PRIVATE_KEY is the App's .pem file, base64-encoded on one line.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_SLUG=
# The App's webhook secret, so issue closed/reopened events are trusted (G4).
GITHUB_WEBHOOK_SECRET=
